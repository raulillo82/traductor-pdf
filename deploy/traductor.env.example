# Copiar a ~/traductor/traductor.env en el servidor (no se sube al repositorio) y rellenar.
BASE_URL=https://example.org/traductor
ADMIN_EMAILS=admin@example.org
# Cuentas aprobadas de antemano (separadas por comas): entran aunque el registro esté cerrado.
PRE_APPROVED_EMAILS=
GOOGLE_CLIENT_ID_FILE=/secrets/google_client_id
GOOGLE_CLIENT_SECRET_FILE=/secrets/google_client_secret
# Máquinas del worker (una o varias, se prueban en orden)
MORDOR_HOSTS=worker1.example.lan,worker2.example.lan
MORDOR_USER=traductor
MORDOR_KEY=/secrets/traductor_mordor
MORDOR_KNOWN_HOSTS=/secrets/known_hosts
MAX_MB=100
MAX_JOBS_PER_DAY=20
RETENTION_HOURS=168
TZ=Europe/Madrid
